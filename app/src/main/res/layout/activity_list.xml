<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F1F5FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- Заголовок и приветствие -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_format"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:lineSpacingExtra="3dp" />

        <!-- Подзаголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="@string/choose_student"
            android:textSize="15sp"
            android:textColor="#64748B" />

        <!-- Карточка со списком -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_main_card"
            android:elevation="3dp">

            <!-- Заголовок карточки -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/list_title"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginBottom="6dp" />

            <!-- Количество студентов -->
            <TextView
                android:id="@+id/tvStudentsCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/students_count"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:layout_marginBottom="16dp" />

            <!-- Здесь ListActivity добавляет кнопки студентов -->
            <LinearLayout
                android:id="@+id/studentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Нижняя подпись -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/footer_text"
            android:textSize="12sp"
            android:textColor="#94A3B8" />

    </LinearLayout>

</ScrollView>
