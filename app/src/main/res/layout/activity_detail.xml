<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F7FB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Имя студента: RelativeLayout -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown_student"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

            </RelativeLayout>

            <!-- Средний балл -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_main_card"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tvGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

            </LinearLayout>

            <!-- Учебная группа -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/group_label"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#263238" />

            <TextView
                android:id="@+id/tvGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/group_value"
                android:textSize="14sp"
                android:textColor="#64748B" />

            <!-- Успеваемость -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="12dp"
                android:text="@string/subjects_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <!-- Программирование -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_main_card"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subject_programming"
                    android:textSize="15sp"
                    android:textColor="#263238" />

                <TextView
                    android:id="@+id/tvProgrammingGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

            </LinearLayout>

            <!-- Математика -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_main_card"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subject_math"
                    android:textSize="15sp"
                    android:textColor="#263238" />

                <TextView
                    android:id="@+id/tvMathGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

            </LinearLayout>

            <!-- Английский язык -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_main_card"
                android:elevation="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subject_english"
                    android:textSize="15sp"
                    android:textColor="#263238" />

                <TextView
                    android:id="@+id/tvEnglishGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Возврат к списку -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0" />

</LinearLayout>